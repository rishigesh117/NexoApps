# ==========================================
# NEXOAPPS PLATFORM CONFIGURATION BLUEPRINT
# ==========================================

# SERVER CONFIG
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# DATABASE CONFIG (POSTGRESQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexoapps_db
DB_USER=nexoapps_admin
DB_PASSWORD=supersecretpassword
DB_SSL=false

# AUTHENTICATION SECURITY (JWT)
JWT_SECRET=super-secret-jwt-key-nexoapps-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-key-nexoapps
JWT_REFRESH_EXPIRES_IN=30d

# STORAGE CONFIGURATION (LOCAL / CLOUD READY)
STORAGE_TYPE=local # 'local' | 's3' | 'cloudinary'
STORAGE_LOCAL_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# ADMIN DEFAULT SEED CONFIG
ADMIN_EMAIL=admin@nexoapps.com
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
