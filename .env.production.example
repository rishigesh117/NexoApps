# NexoApps Production Environment Variables Template
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://nexoapps.com
API_URL=https://nexoapps.com/api/v1

# Security Secrets
JWT_SECRET=your-production-jwt-access-secret-32-chars-min
JWT_REFRESH_SECRET=your-production-jwt-refresh-secret-32-chars-min
JWT_EXPIRES_IN=7d

# Database Configuration
DATABASE_URL=postgresql://nexo_admin:nexo_secure_password_2026@localhost:5432/nexoapps_prod

# Cloud Storage Abstraction (local | s3 | r2 | gcp | azure)
STORAGE_DRIVER=s3
STORAGE_BUCKET=nexoapps-apk-production
STORAGE_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
CORS_ORIGINS=https://nexoapps.com
